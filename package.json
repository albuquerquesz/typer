{
  "name": "typer",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.2"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "check": "biome check --write .",
    "dev:popup": "cd apps/web && bun run desktop:dev",
    "dev:daemon": "cargo run -p typerd",
    "test": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace -- -D warnings",
    "install:local": "./scripts/install.sh"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@typer/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@typer/config": "workspace:*",
    "@kubojs/config": "0.4.1",
    "@biomejs/biome": "^2.5.2"
  },
  "packageManager": "bun@1.3.10"
}
