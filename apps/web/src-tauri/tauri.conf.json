{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typer",
  "version": "0.1.0",
  "identifier": "dev.typer.popup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "typer",
        "width": 260,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "focus": true,
        "transparent": true,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mechanical keyboard sounds for Hyprland"
  }
}
